#include <stdio.h>
#include <string.h>

typedef struct { char nama[50]; int harga; int stock; } Barang;
typedef struct { char nama[50]; int poin; } Member;

void cekBarang(Barang db[], int ukuran) {
    printf("\n--- Katalog Barang ---\n");
    for(int i=0; i<ukuran; i++) {
        printf("%d. %s - Rp%d (Stok: %d)\n", i+1, db[i].nama, db[i].harga, db[i].stock);
    }
}

void cekMember(Member db[], int ukuran) {
    printf("\n--- Data Member ---\n");
    for(int i=0; i<ukuran; i++) {
        printf("%d. %s - Poin: %d\n", i+1, db[i].nama, db[i].poin);
    }
}

void beliBarang(Barang *b, Member *m, int qty) {
    if (b->stock >= qty) {
        b->stock -= qty;
        int total = b->harga * qty;
        
        if (m != NULL && m->poin >= 1000) {
            m->poin -= 1000;
            int diskon = total * 10 / 100;
            total -= diskon;
            printf("\n[PROMO] %s menukar 1000 Poin untuk Diskon 10%% (Potongan Rp%d)!\n", m->nama, diskon);
        }

        printf("\n[TRANSAKSI] %d %s Terjual. Total: Rp%d\n", qty, b->nama, total);
        
        if (total >= 20000 && m != NULL) {
            m->poin += 100;
            printf("  -> Member %s mendapat +100 Poin!\n", m->nama);
        }
    } else {
        printf("\n[GAGAL] Stok %s (Tersisa: %d) tidak cukup untuk dibeli sebanyak %d!\n", b->nama, b->stock, qty);
    }
}

int main() {
    // 1. Setup Database Awal
    Barang dbBarang[5] = { {"Sabun", 5000, 10}, {"Sampo", 15000, 5}, {"Roti", 12000, 8}, {"Susu", 25000, 15}, {"Kopi", 22000, 20} };
    Member dbMember[2] = { {"Anisa", 1200}, {"Budi", 100} };

    int pilihan;
    int tokoBuka = 1; // 1 artinya Buka (True), 0 artinya Tutup (False)

    printf("=== SELAMAT DATANG DI MINIMARKET ===\n");

    // 2. Infinite Loop (Perulangan Menu)
    while (tokoBuka == 1) {
        printf("\n=== MENU UTAMA ===\n");
        printf("[1] Lihat Barang\n");
        printf("[2] Beli Barang\n");
        printf("[3] Cek Member\n");
        printf("[4] Keluar\n");
        printf("Pilih menu (1-4): ");
        scanf("%d", &pilihan);

        // 3. Switch-Case untuk mengeksekusi pilihan
        switch(pilihan) {
            case 1:
                cekBarang(dbBarang, 5);
                break;
                
            case 2: {
                int idBarang, idMember, qty;
                printf("\nMasukkan Nomor Barang (1-5): "); 
                scanf("%d", &idBarang);
                
                printf("Masukkan Jumlah Beli: "); 
                scanf("%d", &qty);
                
                printf("Masukkan Nomor Member (1-Anisa, 2-Budi, 0-Bukan Member): "); 
                scanf("%d", &idMember);

                // Menentukan siapa pembelinya (pointer Member)
                Member *pembeli = NULL;
                if (idMember == 1) pembeli = &dbMember[0];
                else if (idMember == 2) pembeli = &dbMember[1];
                
                // Panggil fungsi beli (idBarang dikurangi 1 karena index array mulai dari 0)
                beliBarang(&dbBarang[idBarang - 1], pembeli, qty);
                break;
            }
            
            case 3:
                cekMember(dbMember, 2);
                break;
                
            case 4:
                printf("\nTerima kasih telah berbelanja! Sistem dimatikan.\n");
                tokoBuka = 0; // Mengubah status toko jadi tutup agar loop berhenti
                break;
                
            default:
                printf("\nPilihan tidak valid! Masukkan angka 1-4.\n");
                break;
        }
    }

    return 0;
}
